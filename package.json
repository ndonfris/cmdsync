{
  "$schema": "https://json.schemastore.org/package",
  "name": "cmdsync",
  "version": "0.1.0",
  "description": "Sync command output into comment-delimited regions of any file: markdown/mdx code blocks and tables, html, changelogs, scripts, configs",
  "author": "ndonfris",
  "license": "MIT",
  "keywords": [
    "markdown",
    "mdx",
    "docs",
    "codeblock",
    "readme",
    "generate",
    "regions",
    "codegen",
    "sync"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndonfris/cmdsync.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "bin": {
    "cmdsync": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./cmdsync.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cmdsync.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs": "tsx src/cli.ts",
    "docs:check": "tsx src/cli.ts --check",
    "prepublishOnly": "yarn build && yarn test"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
