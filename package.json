{
  "$schema": "https://json.schemastore.org/package",
  "name": "cmdsync",
  "version": "0.1.0",
  "description": "Sync command output into comment-delimited regions of any file: markdown/mdx code blocks and tables, html, changelogs, scripts, configs",
  "author": "ndonfris",
  "license": "MIT",
  "keywords": [
    "markdown",
    "mdx",
    "docs",
    "codeblock",
    "readme",
    "generate",
    "regions",
    "codegen",
    "sync"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndonfris/cmdsync.git"
  },
  "homepage": "https://github.com/ndonfris/cmdsync#readme",
  "bugs": {
    "url": "https://github.com/ndonfris/cmdsync/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "cmdsync": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./cmdsync.schema.json",
    "./global.schema.json": "./cmdsync.global.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cmdsync.schema.json",
    "cmdsync.global.schema.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "run-s build",
    "watch": "node scripts/watch.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test",
    "test:coverage": "run-s 'test --experimental-test-coverage --test-coverage-include=src/** {@}' --",
    "verify": "run-s typecheck build 'test {@}' --",
    "docs": "tsx src/cli.ts",
    "docs:check": "run-s 'docs --check'",
    "docs:examples": "run-s 'docs --config examples/diagnostic-codes/cmdsync.json' 'docs --config examples/custom-directives/cmdsync.json'",
    "prepublishOnly": "run-s verify"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "npm-run-all2": "^8.0.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "cmdsync": {
    "exclude": [
      "**/node_modules/**",
      "**/.git/**",
      "examples/**"
    ]
  }
}
